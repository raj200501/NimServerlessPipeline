# Local runtime defaults
NIM_PIPELINE_MODE=local
NIM_PIPELINE_PORT=8080
NIM_PIPELINE_STORAGE_DIR=./local_storage
NIM_PIPELINE_DB_PATH=./local_db/records.jsonl
NIM_PIPELINE_LOG_PATH=./logs/pipeline.log
NIM_PIPELINE_MAX_PAYLOAD=1048576

# AWS (optional)
# NIM_PIPELINE_MODE=aws
# NIM_PIPELINE_AWS_BUCKET=your-bucket
# NIM_PIPELINE_AWS_REGION=us-east-1
# NIM_PIPELINE_AWS_PROFILE=default
